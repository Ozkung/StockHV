# ─── Database ──────────────────────────────────────────────────────────────
# Local dev: use localhost. Docker Compose overrides this automatically.
DATABASE_URL=postgresql://stockhv:stockhv_dev@localhost:5434/stockhv

# ─── Backend (NestJS) ──────────────────────────────────────────────────────
PORT=3001
JWT_SECRET=change-me-must-be-at-least-32-characters-long
JWT_EXPIRES_IN=12h
FRONTEND_URL=http://localhost:3000
# Adjustments with |quantity| above this need a second approver (ADMIN adjustments always apply immediately)
ADJ_AUTO_APPROVE_LIMIT=20
# Lots expiring within this many days show up as "near expiry"
EXPIRY_WARNING_DAYS=30

# ─── Frontend (Next.js) ────────────────────────────────────────────────────
NEXTAUTH_SECRET=change-me-nextauth-secret-32-chars-minimum
NEXTAUTH_URL=http://localhost:3000
# Server-side URL of the backend; the frontend proxies /backend/* to it
API_URL=http://localhost:3001
